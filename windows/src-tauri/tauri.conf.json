{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBar Cockpit",
  "version": "0.1.0-alpha.6",
  "identifier": "io.github.kakapoo233.codexbar-cockpit.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "CodexBar Cockpit",
        "width": 920,
        "height": 760,
        "minWidth": 520,
        "minHeight": 440,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundThrottling": "disabled",
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "resources": {
      "../public/font-licenses/LXGW-OFL.txt": "font-licenses/LXGW-OFL.txt",
      "../public/font-licenses/Smiley-OFL-1.1.txt": "font-licenses/Smiley-OFL-1.1.txt"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "shortDescription": "AI usage and daily allowance in the system tray",
    "longDescription": "A local-first system tray dashboard for usage, daily allowance, calendar and team devices.",
    "copyright": "Copyright Quota Float contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
